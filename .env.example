# ./setup.sh writes this file for you (at the project root, mode 600) after
# prompting for each key. This example exists for reference / manual edits.

# --- read by the harness ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
BASE_RPC_URL=https://mainnet.base.org
AGENT_WALLET_ADDRESS=0xREPLACE_ME          # "address" from econbench-state/wallet.json
ECONBENCH_DIR=/root/econbench-state

# --- read by the AGENT, surfaced in econbench-state/README-keys.md ---
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
TELEGRAM_DETAILS=
AGENTPHONE_API_KEY=        # SMS + voice calls, see https://docs.agentphone.ai

# --- browser automation (agent-browser) state encryption ---
# setup.sh generates this with `openssl rand -hex 32` if unset; enables
# AES-256-GCM encryption of saved sessions/credentials.
AGENT_BROWSER_ENCRYPTION_KEY=
