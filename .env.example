# Copy to /root/econbench.env on the VPS, fill in, then: chmod 600 /root/econbench.env
# Only these four are read by the harness itself.

# Required — your OpenRouter key holding the $20 compute budget.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Public Base RPC (default is fine).
BASE_RPC_URL=https://mainnet.base.org

# The "address" field from econbench-state/wallet.json (generated by setup-vps.sh).
AGENT_WALLET_ADDRESS=0xREPLACE_ME

# State dir the extension and TUI read/write (default for root install).
ECONBENCH_DIR=/root/econbench-state

# --- NOT read by the harness ---
# AgentMail + Telegram creds go in econbench-state/README-keys.md instead,
# because the agent reads that file and drives those APIs itself.
